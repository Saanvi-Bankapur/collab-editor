# Copy this file to .env and adjust if needed.
PORT=4000
DATABASE_URL=postgres://collab:collab@localhost:5432/collab
# Set REDIS_URL=disabled to run a single instance without Redis.
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
# Compact the operation log into a snapshot once a doc has this many stored updates.
COMPACT_THRESHOLD=200
# Create an automatic "auto-save" version at most this often while a doc is being edited.
AUTO_VERSION_MINUTES=10

# ---------------- Optional features (Tier 4) ----------------
# Public URL of the app (links in notification emails)
APP_URL=http://localhost:5173
# AI assist (summarize, rewrite selection, explain version changes).
# Default: Groq's free tier (OpenAI-compatible). Create a key at https://console.groq.com/keys and paste it below.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# Other OpenAI-compatible providers work too, e.g. Google Gemini:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.5-flash
# Or Claude:  AI_PROVIDER=anthropic  AI_BASE_URL=https://api.anthropic.com  AI_MODEL=claude-sonnet-5
# Notification emails. Unset = emails are printed in the server log instead.
SMTP_URL=
MAIL_FROM=CoEdit <no-reply@example.com>
# Image uploads to S3 (unset = images are stored in Postgres, which works everywhere).
S3_BUCKET=
S3_REGION=us-east-1
# S3_PUBLIC_URL=https://dxxxx.cloudfront.net   (optional CDN in front of the bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=5
